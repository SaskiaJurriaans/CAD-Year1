FINAL_Moore <- bind_rows(FINAL_2022, FINAL_2023)
View(FINAL_Moore)
write.xlsx(FINAL_Moore,"C:/Users/sjurriaa/Australian Institute of Marine Science/Carly Randall - Randall Lab/CAD/CAD Field Data/2022_Deployment_Saskia/Instruments data/Marotte_HS_all_reefs/Metrics selection/FINAL_Moore.xlsx")  #optional if you want this output in excel
cor.test(FINAL_Moore$median_speed, FINAL_Moore$percentile_90, method = "pearson")
cor.test(FINAL_Moore$median_speed,FINAL_Moore$percentile_10, method = "pearson")
cor.test(FINAL_Moore$percentile_10, FINAL_Moore$percentile_90, method = "pearson")
cor.test(FINAL_Moore$median_speed, FINAL_Moore$stdev, method = "pearson")
cor.test(FINAL_2022$median_speed, FINAL_2022$stdev, method = "pearson")
cor.test(FINAL_2023$median_speed, FINAL_2023$stdev, method = "pearson")
cor.test(FINAL_Moore$median_speed, FINAL_Moore$stdev, method = "pearson")
cor.test(FINAL_Moore$median_speed, FINAL_Moore$percentile_90, method = "pearson")
cor.test(FINAL_Moore$median_speed,FINAL_Moore$percentile_10, method = "pearson")
cor.test(FINAL_Moore$percentile_10, FINAL_Moore$percentile_90, method = "pearson")
cor.test(FINAL_2022$median_speed, FINAL_2022$stdev, method = "pearson")
cor.test(FINAL_2023$median_speed, FINAL_2023$stdev, method = "pearson")
cor.test(FINAL_Moore$median_speed, FINAL_Moore$stdev, method = "pearson")
